# nspanel-ha — Sonoff NSPanel (ESP32-D0WD, 4 Mo flash, sans PSRAM)

CONFIG_IDF_TARGET="esp32"

# --- Flash / partitions ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- OTA / rollback ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# --- Perf ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- WiFi ---
CONFIG_WIFI_MAX_RETRY=10

# --- HA ---
CONFIG_HA_POLL_INTERVAL_MS=300000
CONFIG_HA_WEATHER_ENTITY="weather.meteo_france_forecast"

# --- UART Nextion (occupe UART2 ; UART0 reste la console/USB) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
